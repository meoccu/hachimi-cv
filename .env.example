# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=please-change-me-to-a-long-random-string

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/resume?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=please-change-me
JWT_EXPIRES_IN=7d
COOKIE_NAME=rp_token

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Resume Platform <noreply@example.com>"

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# WeChat
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CALLBACK_URL=http://localhost:3000/api/auth/wechat/callback
WECHAT_MCH_ID=
WECHAT_MCH_KEY=
WECHAT_NOTIFY_URL=http://localhost:3000/api/billing/wechat/notify

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

# LLM
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Puppeteer (Docker)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_DOWNLOAD=true